---
layout: base.njk
title: "By Hannah Beauty | Nails, Brows, Lashes & Waxing in Walton, Liverpool"
description: "Gel nails, BIAB, brows, lashes and waxing at The Cosmetic Suites, 485 Rice Lane, Walton L9. Rated 5.0 on Treatwell. Book online."
---
    <section class="hero">
      <div class="polka-overlay"></div>
      <div class="hero-content">
        <div class="bow" aria-hidden="true">🎀</div>
        <h1 class="brand-name">
          <span class="brand-by">BY HANNAH</span>
          <span class="brand-beauty">Beauty</span>
        </h1>
        <p class="tagline">Nails, brows, lashes and waxing in Walton, Liverpool</p>
        <p class="location">{{ site.address.venue }}, {{ site.address.street }}, {{ site.address.postcode }}</p>
        <a class="top-rated" href="{{ site.treatwellUrl }}" target="_blank" rel="noopener">
          <svg class="top-rated-star" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true">
            <circle cx="24" cy="24" r="24" fill="#1C1C3A"/>
            <path d="M24 7l4.9 10.6 11.6 1.4-8.6 7.9 2.3 11.5L24 32.6l-10.2 5.8 2.3-11.5-8.6-7.9 11.6-1.4z" fill="#C9A84C"/>
          </svg>
          <span class="top-rated-text">
            <strong>{{ site.accolade.label }} on {{ site.accolade.source }}</strong>
            <span>{{ site.rating.value }} from {{ site.rating.count }} verified reviews</span>
          </span>
        </a>
        <div class="cta-group">
          <a href="{{ site.bookingUrl }}" target="_blank" rel="noopener" class="btn btn-primary">Book on Treatwell</a>
          <a href="#services" class="btn btn-secondary">See prices</a>
        </div>
      </div>
      <div class="hero-wave">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#ffffff"/>
        </svg>
      </div>
    </section>

    <section class="home-intro">
      <div class="container">
        <div class="home-intro-text">
          <h2>Hi, I'm Hannah</h2>
          <p>I do nails, brows, lashes and waxing from my room at The Cosmetic Suites on Rice Lane. I care about the health of your nails as much as how they look, and I love nail art, so bring your ideas.</p>
          <p>You book online through Treatwell. For questions, or an evening appointment, message me on Instagram.</p>
          <p><a href="/about/">More about me and how to find me</a></p>
        </div>
        <a class="home-intro-photos" href="/gallery/" aria-label="See the gallery">
          {%- for img in services[0].images.slice(0, 4) %}
          <img src="/assets/img/{{ img.file }}" alt="{{ img.alt }}" width="{{ img.w }}" height="{{ img.h }}">
          {%- endfor %}
        </a>
      </div>
    </section>

    <section class="home-services" id="services">
      <div class="container">
        <h2>Treatments and prices</h2>
        <ul class="service-list">
          {%- for s in services %}
          <li>
            <a href="/{{ s.slug }}/">
              <span class="service-list-name">{{ s.name }}</span>
              <span class="service-list-blurb">{{ s.blurb }}</span>
              <span class="service-list-price">from {{ s | fromPrice }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section class="reviews home-reviews">
      <div class="container">
        <h2>{{ site.rating.value }} from {{ site.rating.count }} reviews on Treatwell</h2>
        <div class="review-list review-list--three">
          {%- for r in reviews | featured %}
          <figure class="review">
            <blockquote>{{ r.text }}</blockquote>
            <figcaption>{{ r.name }} · {{ r.treatment }} · {{ r.date }}</figcaption>
          </figure>
          {%- endfor %}
        </div>
        <p class="prices-note"><a href="{{ site.treatwellUrl }}" target="_blank" rel="noopener">Read every review on Treatwell</a></p>
      </div>
    </section>

    <section class="home-packages">
      <div class="container">
        <h2>Packages</h2>
        <p class="home-lead">Book treatments together and pay less than you would separately.</p>
        <ul class="package-rows">
          {%- for p in packages.onTreatwell %}
          <li>
            <span class="package-rows-name">{{ p.name }}</span>
            <span class="package-rows-time">{{ p.duration }}</span>
            <span class="package-rows-price">{{ p.price }} <s>{{ p.usualPrice }}</s></span>
          </li>
          {%- endfor %}
        </ul>
        <a class="btn btn-secondary" href="/packages/">See what each package includes</a>
      </div>
    </section>

    <section class="home-find">
      <div class="container home-find-grid">
        <img src="/assets/img/shopfront-the-cosmetic-suites-rice-lane.jpg" alt="The Cosmetic Suites shopfront on Rice Lane, where By Hannah Beauty is based" width="800" height="500" loading="lazy">
        <div>
          <h2>Find me</h2>
          <address class="find-address">
            {{ site.address.venue }}<br>
            {{ site.address.street }}, {{ site.address.area }}<br>
            {{ site.address.city }} {{ site.address.postcode }}
          </address>
          <p>{{ site.hoursText }}</p>
          <p>Orrell Park station is around the corner and there is free parking.</p>
          <p><a href="/about/">Opening hours and directions</a></p>
        </div>
      </div>
    </section>
